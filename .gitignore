# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 运行产物与客户数据（客户报价原文 / ERP 输出 / 日志）—— 不进仓库
logs/
# 校准语料库（真实客户附件 + ERP 导出，仅本地回归用）—— 客户原文不进仓库
customer-files/samples/
customer-files/processed/
customer-files/failed/
customer-files/logs/
customer-files/pending/*
!customer-files/pending/.gitkeep
# 定时扫描器的运行状态（flock 锁 + 重试计数）—— 机器本地的东西，不进仓库
customer-files/.scan.lock
customer-files/.scan_state.json

# 校准草稿（calibrate_customer.py 生成，仅供对照，不入库）
customers/_draft_*.yaml

# 测试缓存
.pytest_cache/
